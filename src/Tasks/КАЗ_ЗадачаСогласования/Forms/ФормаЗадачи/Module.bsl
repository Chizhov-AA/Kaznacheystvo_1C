// Завершает задачу согласования выбранным решением. Отметка задачи выполненной
// и запись автоматически приводит к срабатыванию точки маршрута бизнес-процесса
// КАЗ_СогласованиеЗаявкиБП (обработчик СогласоватьПриВыполнении в его модуле
// объекта), который создает и проводит документ КАЗ_СогласованиеЗаявки по
// выбранному здесь решению - это и есть связка задачи/БП с документом
// согласования.
&НаКлиенте
Процедура ЗавершитьСРешением(Команда)

	Если Не ЗначениеЗаполнено(Объект.Решение) Тогда
		Сообщить("Не выбрано решение по задаче.");
		Возврат;
	КонецЕсли;

	Объект.Выполнена = Истина;
	Записать();
	Закрыть();

КонецПроцедуры
