Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Заявки.Количество() = 0 Тогда
		Сообщить("В реестре платежей нет заявок.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.КАЗ_ФактическиеПлатежи.Записывать = Истина;

	Для Каждого СтрокаЗаявки Из Заявки Цикл

		Если Не ЗначениеЗаполнено(СтрокаЗаявки.Заявка) Тогда
			Сообщить("В табличной части есть строка без заявки.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		ДанныеЗаявки = СтрокаЗаявки.Заявка;

		Движение = Движения.КАЗ_ФактическиеПлатежи.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Заявка = СтрокаЗаявки.Заявка;
		Движение.Контрагент = СтрокаЗаявки.Контрагент;
		Движение.Сумма = СтрокаЗаявки.Сумма;

		ОбъектЗаявки = СтрокаЗаявки.Заявка.ПолучитьОбъект();
		ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Оплачена;
		ОбъектЗаявки.Записать();

	КонецЦикла;

КонецПроцедуры