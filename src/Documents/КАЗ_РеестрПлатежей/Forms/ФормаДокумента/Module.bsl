                          &НаКлиенте
Процедура ЗаявкиЗаявкаПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.Заявки.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Заявка) Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьДанныеЗаявки(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеЗаявки(СтрокаТЧ)

	ДанныеЗаявки = ПолучитьДанныеЗаявкиНаСервере(СтрокаТЧ.Заявка);

	СтрокаТЧ.Контрагент = ДанныеЗаявки.Контрагент;
	СтрокаТЧ.Сумма = ДанныеЗаявки.Сумма;
	СтрокаТЧ.Статус = ДанныеЗаявки.Статус;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеЗаявкиНаСервере(Заявка)

	Результат = Новый Структура;
	Результат.Вставить("Контрагент", Заявка.Контрагент);
	Результат.Вставить("Сумма", Заявка.СуммаДокумента);
	Результат.Вставить("Статус", Заявка.Статус);

	Возврат Результат;

КонецФункции