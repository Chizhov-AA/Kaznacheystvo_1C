Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Источник) Тогда
		Сообщить("Не указан источник перемещения.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Приемник) Тогда
		Сообщить("Не указан приемник перемещения.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Источник = Приемник Тогда
		Сообщить("Источник и приемник перемещения совпадают.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Сумма <= 0 Тогда
		Сообщить("Сумма перемещения должна быть больше нуля.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ИзмеренияОстатка = Новый Структура("СчетКасса", Источник);
	ТекущийОстаток = КазначействоПроверкаЛимитов.ПроверитьДостаточностьОстатка(
		"КАЗ_ОстаткиСчетовИКасс", "Сумма", ИзмеренияОстатка, Сумма, Дата, Отказ);

	Если Отказ Тогда
		Сообщить("Недостаточно средств на источнике. Остаток: " + Формат(ТекущийОстаток, "ЧДЦ=2"));
		Возврат;
	КонецЕсли;

	Движения.КАЗ_ОстаткиСчетовИКасс.Записывать = Истина;

	ДвижениеРасход = Движения.КАЗ_ОстаткиСчетовИКасс.Добавить();
	ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
	ДвижениеРасход.Период = Дата;
	ДвижениеРасход.СчетКасса = Источник;
	ДвижениеРасход.Сумма = Сумма;

	ДвижениеПриход = Движения.КАЗ_ОстаткиСчетовИКасс.Добавить();
	ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
	ДвижениеПриход.Период = Дата;
	ДвижениеПриход.СчетКасса = Приемник;
	ДвижениеПриход.Сумма = Сумма;

КонецПроцедуры
