Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Сообщить("Не выбрана заявка для аннулирования.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ОбъектЗаявки = Заявка.ПолучитьОбъект();

	Если ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Оплачена Тогда
		Сообщить("Нельзя аннулировать уже оплаченную заявку.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.КАЗ_ПлановыеПлатежи.Записывать = Истина;

	Движение = Движения.КАЗ_ПлановыеПлатежи.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Заявка = Заявка;
	Движение.Контрагент = ОбъектЗаявки.Контрагент;
	Движение.СтатьяПлатежа = ОбъектЗаявки.СтатьяПлатежа;
	Движение.ЦФО = ОбъектЗаявки.ЦФО;
	Движение.Сумма = ОбъектЗаявки.СуммаДокумента;

	ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Отменена;
	ОбъектЗаявки.Записать();

КонецПроцедуры
