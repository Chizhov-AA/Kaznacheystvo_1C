Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Сообщить("Не заполнен контрагент.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтатьяПлатежа) Тогда
		Сообщить("Не заполнена статья платежа.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЦФО) Тогда
		Сообщить("Не заполнен центр финансовой ответственности.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если СуммаДокумента <= 0 Тогда
		Сообщить("Сумма заявки должна быть больше нуля.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

// Получаем установленный лимит
ЗапросЛимита = Новый Запрос;
ЗапросЛимита.Текст =
"ВЫБРАТЬ
|	ЕСТЬNULL(ЛимитыОстатки.ЛимитОстаток, 0) КАК Лимит
|ИЗ
|	РегистрНакопления.КАЗ_ЛимитыПлатежей.Остатки(&Дата, ЦФО = &ЦФО И СтатьяПлатежа = &СтатьяПлатежа) КАК ЛимитыОстатки";

ЗапросЛимита.УстановитьПараметр("Дата", Дата);
ЗапросЛимита.УстановитьПараметр("ЦФО", ЦФО);
ЗапросЛимита.УстановитьПараметр("СтатьяПлатежа", СтатьяПлатежа);

РезультатЛимита = ЗапросЛимита.Выполнить().Выбрать();

Лимит = 0;
Если РезультатЛимита.Следующий() Тогда
	Лимит = РезультатЛимита.Лимит;
КонецЕсли;


// Получаем уже использованную сумму по проведенным заявкам
ЗапросИспользовано = Новый Запрос;
ЗапросИспользовано.Текст =
"ВЫБРАТЬ
|	ЕСТЬNULL(СУММА(ПлановыеПлатежиОбороты.СуммаОборот), 0) КАК Использовано
|ИЗ
|	РегистрНакопления.КАЗ_ПлановыеПлатежи.Обороты(, &Дата, , ЦФО = &ЦФО И СтатьяПлатежа = &СтатьяПлатежа) КАК ПлановыеПлатежиОбороты
|ГДЕ
|	ПлановыеПлатежиОбороты.Заявка <> &ТекущаяЗаявка";

ЗапросИспользовано.УстановитьПараметр("Дата", Дата);
ЗапросИспользовано.УстановитьПараметр("ЦФО", ЦФО);
ЗапросИспользовано.УстановитьПараметр("СтатьяПлатежа", СтатьяПлатежа);
ЗапросИспользовано.УстановитьПараметр("ТекущаяЗаявка", Ссылка);

РезультатИспользовано = ЗапросИспользовано.Выполнить().Выбрать();

Использовано = 0;
Если РезультатИспользовано.Следующий() Тогда
	Использовано = РезультатИспользовано.Использовано;
КонецЕсли;

Доступно = Лимит - Использовано;

Если Доступно < СуммаДокумента Тогда

	Сообщить("Недостаточно лимита для проведения заявки. Доступно: "
		+ Формат(Доступно, "ЧДЦ=2")
		+ ", требуется: "
		+ Формат(СуммаДокумента, "ЧДЦ=2"));

	Отказ = Истина;
	Возврат;

КонецЕсли;
	Движения.КАЗ_ПлановыеПлатежи.Записывать = Истина;

	Движение = Движения.КАЗ_ПлановыеПлатежи.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Заявка = Ссылка;
	Движение.Контрагент = Контрагент;
	Движение.СтатьяПлатежа = СтатьяПлатежа;
	Движение.ЦФО = ЦФО;
	Движение.Сумма = СуммаДокумента;

КонецПроцедуры
