     &НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Объект.Договор = НайтиДоговорКонтрагентаНаСервере(Объект.Контрагент);

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиДоговорКонтрагентаНаСервере(Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Контрагент
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();

КонецФункции

&НаКлиенте
Процедура СтатьяПлатежаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.СтатьяПлатежа) Тогда

		ТекстШаблона = ПолучитьТекстШаблонаНазначенияНаСервере(Объект.СтатьяПлатежа);

		Если ЗначениеЗаполнено(ТекстШаблона) Тогда
			Объект.ОснованиеПлатежа = ТекстШаблона;
		КонецЕсли;

	КонецЕсли;

	ОбновитьОстатокЛимита();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстШаблонаНазначенияНаСервере(СтатьяПлатежа)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Шаблоны.ТекстНазначенияПлатежа КАК ТекстНазначенияПлатежа
	|ИЗ
	|	Справочник.КАЗ_ШаблоныНазначенияПлатежа КАК Шаблоны
	|ГДЕ
	|	Шаблоны.СтатьяПлатежа = &СтатьяПлатежа
	|	И НЕ Шаблоны.ПометкаУдаления
	|	И НЕ Шаблоны.ЭтоГруппа";

	Запрос.УстановитьПараметр("СтатьяПлатежа", СтатьяПлатежа);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ТекстНазначенияПлатежа;
	КонецЕсли;

	Возврат "";

КонецФункции

&НаКлиенте
Процедура ЦФОПриИзменении(Элемент)

	ОбновитьОстатокЛимита();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОстатокЛимита()

	Если ЗначениеЗаполнено(Объект.ЦФО) И ЗначениеЗаполнено(Объект.СтатьяПлатежа) Тогда
		Элементы.ОстатокЛимита.Заголовок = ПолучитьОстатокЛимитаНаСервере(Объект.ЦФО, Объект.СтатьяПлатежа, Объект.Дата, Объект.Ссылка);
	Иначе
		Элементы.ОстатокЛимита.Заголовок = "";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОстатокЛимитаНаСервере(ЦФО, СтатьяПлатежа, Дата, ТекущаяЗаявка)

	ЗапросЛимита = Новый Запрос;
	ЗапросЛимита.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЛимитыОстатки.ЛимитОстаток, 0) КАК Лимит
	|ИЗ
	|	РегистрНакопления.КАЗ_ЛимитыПлатежей.Остатки(&Дата, ЦФО = &ЦФО И СтатьяПлатежа = &СтатьяПлатежа) КАК ЛимитыОстатки";

	ЗапросЛимита.УстановитьПараметр("Дата", Дата);
	ЗапросЛимита.УстановитьПараметр("ЦФО", ЦФО);
	ЗапросЛимита.УстановитьПараметр("СтатьяПлатежа", СтатьяПлатежа);

	РезультатЛимита = ЗапросЛимита.Выполнить().Выбрать();

	Лимит = 0;
	Если РезультатЛимита.Следующий() Тогда
		Лимит = РезультатЛимита.Лимит;
	КонецЕсли;

	ЗапросИспользовано = Новый Запрос;
	ЗапросИспользовано.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ПлановыеПлатежиОбороты.СуммаОборот), 0) КАК Использовано
	|ИЗ
	|	РегистрНакопления.КАЗ_ПлановыеПлатежи.Обороты(, &Дата, , ЦФО = &ЦФО И СтатьяПлатежа = &СтатьяПлатежа) КАК ПлановыеПлатежиОбороты
	|ГДЕ
	|	ПлановыеПлатежиОбороты.Заявка <> &ТекущаяЗаявка";

	ЗапросИспользовано.УстановитьПараметр("Дата", Дата);
	ЗапросИспользовано.УстановитьПараметр("ЦФО", ЦФО);
	ЗапросИспользовано.УстановитьПараметр("СтатьяПлатежа", СтатьяПлатежа);
	ЗапросИспользовано.УстановитьПараметр("ТекущаяЗаявка", ТекущаяЗаявка);

	РезультатИспользовано = ЗапросИспользовано.Выполнить().Выбрать();

	Использовано = 0;
	Если РезультатИспользовано.Следующий() Тогда
		Использовано = РезультатИспользовано.Использовано;
	КонецЕсли;

	Возврат "Остаток лимита: " + Формат(Лимит - Использовано, "ЧДЦ=2");

КонецФункции

&НаКлиенте
Процедура ТоварыУслугиКоличествоПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.ТоварыУслуги.ТекущиеДанные;

	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	КонецЕсли;

	ПересчитатьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыУслугиЦенаПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.ТоварыУслуги.ТекущиеДанные;

	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	КонецЕсли;

	ПересчитатьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтог()

	Итого = 0;

	Для Каждого СтрокаТЧ Из Объект.ТоварыУслуги Цикл
		Итого = Итого + СтрокаТЧ.Сумма;
	КонецЦикла;

	Объект.СуммаДокумента = Итого;

КонецПроцедуры

