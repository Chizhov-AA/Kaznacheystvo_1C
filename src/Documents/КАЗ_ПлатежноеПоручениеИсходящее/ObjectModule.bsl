Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Сообщить("Не выбрана заявка на оплату.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СчетОрганизации) Тогда
		Сообщить("Не выбран банковский счет.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Сумма <= 0 Тогда
		Сообщить("Сумма платежного поручения должна быть больше нуля.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ОбъектЗаявки = Заявка.ПолучитьОбъект();

	Если ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Оплачена Тогда
		Сообщить("Заявка уже оплачена, повторная оплата невозможна.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ОбъектЗаявки.Статус <> Перечисления.КАЗ_СтатусыЗаявки.Согласована Тогда
		Сообщить("Оплата возможна только по согласованной заявке.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Проверка остатка на счете — по аналогии с проверкой остатка в кассе в КАЗ_РасходныйКассовыйОрдер
	ЗапросОстатка = Новый Запрос;
	ЗапросОстатка.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Остатки.СуммаОстаток, 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.КАЗ_ОстаткиСчетовИКасс.Остатки(&Дата, СчетКасса = &СчетОрганизации) КАК Остатки";
	ЗапросОстатка.УстановитьПараметр("Дата", Дата);
	ЗапросОстатка.УстановитьПараметр("СчетОрганизации", СчетОрганизации);
	РезультатОстатка = ЗапросОстатка.Выполнить().Выбрать();
	ТекущийОстаток = 0;
	Если РезультатОстатка.Следующий() Тогда
		ТекущийОстаток = РезультатОстатка.Остаток;
	КонецЕсли;

	Если ТекущийОстаток < Сумма Тогда
		Сообщить("Недостаточно средств на счете. Остаток: " + Формат(ТекущийОстаток, "ЧДЦ=2"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.КАЗ_ФактическиеПлатежи.Записывать = Истина;

	Движение = Движения.КАЗ_ФактическиеПлатежи.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Заявка = Заявка;
	Движение.Контрагент = ОбъектЗаявки.Контрагент;
	Движение.Сумма = Сумма;

	Движения.КАЗ_ОстаткиСчетовИКасс.Записывать = Истина;

	ДвижениеСчета = Движения.КАЗ_ОстаткиСчетовИКасс.Добавить();
	ДвижениеСчета.ВидДвижения = ВидДвиженияНакопления.Расход;
	ДвижениеСчета.Период = Дата;
	ДвижениеСчета.СчетКасса = СчетОрганизации;
	ДвижениеСчета.Сумма = Сумма;

	ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Оплачена;
	ОбъектЗаявки.Записать();

КонецПроцедуры
