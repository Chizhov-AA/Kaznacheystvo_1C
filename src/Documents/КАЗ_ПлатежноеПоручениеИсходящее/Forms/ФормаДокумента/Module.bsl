&НаКлиенте
Процедура ЗаявкаПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Заявка) Тогда
		Возврат;
	КонецЕсли;

	ДанныеЗаявки = ПолучитьДанныеЗаявкиНаСервере(Объект.Заявка);

	Объект.Сумма = ДанныеЗаявки.Сумма;

	Если Не ЗначениеЗаполнено(Объект.СчетОрганизации) Тогда
		Объект.СчетОрганизации = ПервыйСчетОрганизацииНаСервере();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.НазначениеПлатежа) И ЗначениеЗаполнено(ДанныеЗаявки.ТекстШаблона) Тогда
		Объект.НазначениеПлатежа = ДанныеЗаявки.ТекстШаблона;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеЗаявкиНаСервере(Заявка)

	Результат = Новый Структура("Сумма, ТекстШаблона", 0, "");
	Результат.Сумма = Заявка.СуммаДокумента;

	Если ЗначениеЗаполнено(Заявка.СтатьяПлатежа) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Шаблоны.ТекстНазначенияПлатежа КАК ТекстНазначенияПлатежа
		|ИЗ
		|	Справочник.КАЗ_ШаблоныНазначенияПлатежа КАК Шаблоны
		|ГДЕ
		|	Шаблоны.СтатьяПлатежа = &СтатьяПлатежа
		|	И НЕ Шаблоны.ПометкаУдаления
		|	И НЕ Шаблоны.ЭтоГруппа";

		Запрос.УстановитьПараметр("СтатьяПлатежа", Заявка.СтатьяПлатежа);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Результат.ТекстШаблона = Выборка.ТекстНазначенияПлатежа;
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПервыйСчетОрганизацииНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КАЗ_БанковскиеСчетаОрганизации КАК Счета
	|ГДЕ
	|	НЕ Счета.ПометкаУдаления
	|	И НЕ Счета.ЭтоГруппа";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.КАЗ_БанковскиеСчетаОрганизации.ПустаяСсылка();

КонецФункции
