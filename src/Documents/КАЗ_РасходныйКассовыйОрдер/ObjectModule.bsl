Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Касса) Тогда
		Сообщить("Не выбрана касса.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ПолучательФИО) Тогда
		Сообщить("Не указан получатель.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Сумма <= 0 Тогда
		Сообщить("Сумма РКО должна быть больше нуля.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Проверка остатка в кассе — по аналогии с проверкой лимита в КАЗ_ЗаявкаНаОплату
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Остатки.СуммаОстаток, 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.КАЗ_ОстаткиСчетовИКасс.Остатки(&Дата, СчетКасса = &Касса) КАК Остатки";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Касса", Касса);
	Выборка = Запрос.Выполнить().Выбрать();
	ТекущийОстаток = 0;
	Если Выборка.Следующий() Тогда
		ТекущийОстаток = Выборка.Остаток;
	КонецЕсли;

	Если ТекущийОстаток < Сумма Тогда
		Сообщить("Недостаточно средств в кассе. Остаток: " + Формат(ТекущийОстаток, "ЧДЦ=2"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.КАЗ_ФактическиеПлатежи.Записывать = Истина;
	ДвижениеПлатеж = Движения.КАЗ_ФактическиеПлатежи.Добавить();
	ДвижениеПлатеж.ВидДвижения = ВидДвиженияНакопления.Расход;
	ДвижениеПлатеж.Период = Дата;
	ДвижениеПлатеж.Заявка = Заявка;
	ДвижениеПлатеж.Сумма = Сумма;

	Движения.КАЗ_ОстаткиСчетовИКасс.Записывать = Истина;
	ДвижениеКасса = Движения.КАЗ_ОстаткиСчетовИКасс.Добавить();
	ДвижениеКасса.ВидДвижения = ВидДвиженияНакопления.Расход;
	ДвижениеКасса.Период = Дата;
	ДвижениеКасса.СчетКасса = Касса;
	ДвижениеКасса.Сумма = Сумма;

	Если ЗначениеЗаполнено(Заявка) Тогда
		ОбъектЗаявки = Заявка.ПолучитьОбъект();
		Если ОбъектЗаявки.Статус <> Перечисления.КАЗ_СтатусыЗаявки.Оплачена Тогда
			ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Оплачена;
			ОбъектЗаявки.Записать();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
