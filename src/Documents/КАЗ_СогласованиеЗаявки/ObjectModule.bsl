Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Сообщить("Не выбрана заявка на оплату.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Решение) Тогда
		Сообщить("Не выбрано решение по согласованию.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Согласующий) Тогда
		Сообщить("Не указан согласующий.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ОбъектЗаявки = Заявка.ПолучитьОбъект();

	Если Решение = Перечисления.КАЗ_РешенияСогласования.Согласовано Тогда
		ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Согласована;
	ИначеЕсли Решение = Перечисления.КАЗ_РешенияСогласования.Отклонено Тогда
		ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Отклонена;
	ИначеЕсли Решение = Перечисления.КАЗ_РешенияСогласования.ВозвращеноНаДоработку Тогда
		ОбъектЗаявки.Статус = Перечисления.КАЗ_СтатусыЗаявки.Черновик;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаРешения) Тогда
		ДатаРешения = ТекущаяДата();
	КонецЕсли;

	ОбъектЗаявки.Записать();

	НаборЗаписей = РегистрыСведений.КАЗ_ИсторияСогласования.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заявка.Установить(Заявка);
	НаборЗаписей.Отбор.НомерЭтапа.Установить(НомерЭтапа);

	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Заявка = Заявка;
	НоваяЗапись.НомерЭтапа = НомерЭтапа;
	НоваяЗапись.Период = ДатаРешения;
	НоваяЗапись.Согласующий = Согласующий;
	НоваяЗапись.Решение = Решение;
	НоваяЗапись.Комментарий = Комментарий;

	НаборЗаписей.Записать();

КонецПроцедуры