&НаКлиенте
Процедура ЗаявкаПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Заявка) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Согласующий) Тогда
		Объект.Согласующий = ТекущийПользовательКаталогаНаСервере();
	КонецЕсли;

	Объект.НомерЭтапа = СледующийНомерЭтапаНаСервере(Объект.Заявка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийПользовательКаталогаНаСервере()

	Возврат КазначействоРаботаСДокументами.ТекущийПользовательКаталога();

КонецФункции

&НаСервереБезКонтекста
Функция СледующийНомерЭтапаНаСервере(Заявка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(История.НомерЭтапа) КАК МаксНомерЭтапа
	|ИЗ
	|	РегистрСведений.КАЗ_ИсторияСогласования КАК История
	|ГДЕ
	|	История.Заявка = &Заявка";

	Запрос.УстановитьПараметр("Заявка", Заявка);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.МаксНомерЭтапа) Тогда
		Возврат Выборка.МаксНомерЭтапа + 1;
	КонецЕсли;

	Возврат 1;

КонецФункции
