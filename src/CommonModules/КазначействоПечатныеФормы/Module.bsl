// Формирует единообразную печатную форму отчета: шапка организации,
// название отчета, дата формирования, а под ней - таблица с уже
// готовым результатом отчета.
//
// Параметры:
//   ЗаголовокОтчета         - Строка - название отчета (берется из синонима метаданных)
//   ТабличныйДокументОтчета - ТабличныйДокумент - уже сформированный результат СКД отчета
//
// Возвращаемое значение:
//   ТабличныйДокумент - готовая к печати/просмотру печатная форма
//
Функция СформироватьПечатнуюФорму(ЗаголовокОтчета, ТабличныйДокументОтчета) Экспорт

	Результат = Новый ТабличныйДокумент;

	КоличествоКолонок = Макс(ТабличныйДокументОтчета.ШиринаТаблицы, 10);
	ПоследняяКолонка = "C" + Строка(КоличествоКолонок);

	// Шапка
	ОбластьОрганизации = Результат.Область("R1C1:R1" + ПоследняяКолонка);
	ОбластьОрганизации.Объединить();
	ОбластьОрганизации.СодержимоеТекст = "Московский университет имени С.Ю. Витте";
	ОбластьОрганизации.ШрифтЖирный = Истина;
	ОбластьОрганизации.РазмерШрифта = 12;

	Результат.ВывестиГоризонтальнуюЛинию();

	ОбластьЗаголовка = Результат.Область("R2C1:R2" + ПоследняяКолонка);
	ОбластьЗаголовка.Объединить();
	ОбластьЗаголовка.СодержимоеТекст = ЗаголовокОтчета;
	ОбластьЗаголовка.ШрифтЖирный = Истина;
	ОбластьЗаголовка.РазмерШрифта = 14;

	ОбластьДаты = Результат.Область("R3C1:R3" + ПоследняяКолонка);
	ОбластьДаты.Объединить();
	ОбластьДаты.СодержимоеТекст = "Сформировано: " + Формат(ТекущаяДата(), "ДЛФ=DD");

	Результат.ВывестиГоризонтальнуюЛинию();

	// Вставка самой таблицы отчета под шапкой
	Результат.Вывести(ТабличныйДокументОтчета);

	Возврат Результат;

КонецФункции
