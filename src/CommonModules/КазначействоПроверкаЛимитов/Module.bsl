// Возвращает остаток по регистру накопления вида "Остатки" на дату с отбором по измерениям.
//
// Параметры:
//   ИмяРегистра - Строка - имя регистра накопления (например, "КАЗ_ОстаткиСчетовИКасс")
//   ИмяРесурса  - Строка - имя ресурса, остаток которого нужно получить (например, "Сумма")
//   Измерения   - Структура - соответствие ИмяИзмерения/Значение для отбора виртуальной таблицы Остатки()
//   Дата        - Дата - момент времени, на который считается остаток
//
// Возвращаемое значение:
//   Число - остаток ресурса на дату с учетом отбора
//
Функция ПолучитьОстатокРегистра(ИмяРегистра, ИмяРесурса, Измерения, Дата) Экспорт

	Запрос = Новый Запрос;

	УсловиеОтбора = "";
	Для Каждого ИзмерениеОтбора Из Измерения Цикл
		Если УсловиеОтбора <> "" Тогда
			УсловиеОтбора = УсловиеОтбора + " И ";
		КонецЕсли;
		УсловиеОтбора = УсловиеОтбора + ИзмерениеОтбора.Ключ + " = &" + ИзмерениеОтбора.Ключ;
		Запрос.УстановитьПараметр(ИзмерениеОтбора.Ключ, ИзмерениеОтбора.Значение);
	КонецЦикла;

	Если УсловиеОтбора <> "" Тогда
		УсловиеОтбора = ", " + УсловиеОтбора;
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Остатки." + ИмяРесурса + "Остаток, 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления." + ИмяРегистра + ".Остатки(&Дата" + УсловиеОтбора + ") КАК Остатки";

	Запрос.УстановитьПараметр("Дата", Дата);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Остаток;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Проверяет, достаточно ли остатка регистра для списания указанной суммы, и при недостатке
// устанавливает Отказ = Истина. Само сообщение пользователю формирует вызывающий код -
// текст отличается в разных документах ("в кассе"/"на счете"/"на источнике").
//
// Параметры:
//   ИмяРегистра - Строка
//   ИмяРесурса  - Строка
//   Измерения   - Структура - отбор виртуальной таблицы Остатки()
//   Сумма       - Число - сумма, которую требуется списать
//   Дата        - Дата
//   Отказ       - Булево - устанавливается в Истина, если остатка недостаточно
//
// Возвращаемое значение:
//   Число - текущий остаток (для вывода в сообщении пользователю)
//
Функция ПроверитьДостаточностьОстатка(ИмяРегистра, ИмяРесурса, Измерения, Сумма, Дата, Отказ) Экспорт

	ТекущийОстаток = ПолучитьОстатокРегистра(ИмяРегистра, ИмяРесурса, Измерения, Дата);

	Если ТекущийОстаток < Сумма Тогда
		Отказ = Истина;
	КонецЕсли;

	Возврат ТекущийОстаток;

КонецФункции
