// Возвращает элемент справочника Пользователи, соответствующий текущему пользователю
// информационной базы. Используется там, где нужно подставить "себя" как согласующего/
// ответственного (форма КАЗ_СогласованиеЗаявки, назначение задач бизнес-процесса и т.п.).
//
// Возвращаемое значение:
//   СправочникСсылка.Пользователи - найденный элемент, либо пустая ссылка, если соответствие
//   не найдено (например, сеанс запущен под пользователем без привязки к справочнику)
//
Функция ТекущийПользовательКаталога() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &Идентификатор";

	Запрос.УстановитьПараметр("Идентификатор", ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции
