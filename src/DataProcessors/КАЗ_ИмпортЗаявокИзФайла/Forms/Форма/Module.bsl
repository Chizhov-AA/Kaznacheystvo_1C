&НаКлиенте
Процедура ВыбратьФайл(Команда)

	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл с заявками";
	ДиалогВыбора.Фильтр = "Файлы Excel (*.xlsx)|*.xlsx";
	ДиалогВыбора.Множественныйвыбор = Ложь;

	Если ДиалогВыбора.Выбрать() Тогда
		ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗаявки(Команда)

	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Сообщить("Не выбран файл.");
		Возврат;
	КонецЕсли;

	РезультатыЗагрузки.Очистить();

	Итог = ЗагрузитьИзФайлаНаСервере(ПутьКФайлу);

	Сообщить("Загружено заявок: " + Итог.КоличествоЗагружено + ". Ошибок: " + Итог.КоличествоОшибок + ".");

КонецПроцедуры

// Читает Excel-файл (шапка в первой строке: ЦФО | Статья платежа | Контрагент |
// Сумма | Основание) и создает по каждой строке черновик КАЗ_ЗаявкаНаОплату.
// Документы не проводятся - пользователь проверяет результат в таблице
// предпросмотра и проводит заявки сам.
&НаСервере
Функция ЗагрузитьИзФайлаНаСервере(ПутьКФайлу)

	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ПутьКФайлу);
	Исключение
		Сообщить("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат Новый Структура("КоличествоЗагружено, КоличествоОшибок", 0, 0);
	КонецПопытки;

	КоличествоЗагружено = 0;
	КоличествоОшибок = 0;

	НомерСтроки = 2; // первая строка - шапка, пропускаем
	Пока Истина Цикл

		ИмяЦФО = СокрЛП(ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		Если ПустаяСтрока(ИмяЦФО) Тогда
			Прервать; // дошли до конца данных
		КонецЕсли;

		ИмяСтатьи = СокрЛП(ТабДок.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		ИмяКонтрагента = СокрЛП(ТабДок.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
		ТекстСуммы = СокрЛП(ТабДок.Область(НомерСтроки, 4, НомерСтроки, 4).Текст);
		Основание = СокрЛП(ТабДок.Область(НомерСтроки, 5, НомерСтроки, 5).Текст);

		СтрокаРезультата = РезультатыЗагрузки.Добавить();
		СтрокаРезультата.НомерСтроки = НомерСтроки;
		СтрокаРезультата.ЦФО = ИмяЦФО;
		СтрокаРезультата.СтатьяПлатежа = ИмяСтатьи;
		СтрокаРезультата.Контрагент = ИмяКонтрагента;
		СтрокаРезультата.Сумма = ЧислоИзСтроки(ТекстСуммы);

		ЦФО = Справочники.КАЗ_ЦентрыФинансовойОтветственности.НайтиПоНаименованию(ИмяЦФО, Истина);
		Статья = Справочники.КАЗ_СтатьиПлатежей.НайтиПоНаименованию(ИмяСтатьи, Истина);
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ИмяКонтрагента, Истина);

		Если Не ЗначениеЗаполнено(ЦФО) Тогда
			СтрокаРезультата.Статус = "Ошибка";
			СтрокаРезультата.Комментарий = "Не найден ЦФО: " + ИмяЦФО;
		ИначеЕсли Не ЗначениеЗаполнено(Статья) Тогда
			СтрокаРезультата.Статус = "Ошибка";
			СтрокаРезультата.Комментарий = "Не найдена статья платежа: " + ИмяСтатьи;
		ИначеЕсли Не ЗначениеЗаполнено(Контрагент) Тогда
			СтрокаРезультата.Статус = "Ошибка";
			СтрокаРезультата.Комментарий = "Не найден контрагент: " + ИмяКонтрагента;
		ИначеЕсли СтрокаРезультата.Сумма <= 0 Тогда
			СтрокаРезультата.Статус = "Ошибка";
			СтрокаРезультата.Комментарий = "Некорректная сумма: " + ТекстСуммы;
		Иначе

			Документ = Документы.КАЗ_ЗаявкаНаОплату.СоздатьДокумент();
			Документ.Дата = ТекущаяДата();
			Документ.ЦФО = ЦФО;
			Документ.СтатьяПлатежа = Статья;
			Документ.Контрагент = Контрагент;
			Документ.СуммаДокумента = СтрокаРезультата.Сумма;
			Документ.ОснованиеПлатежа = Основание;
			Документ.Статус = Перечисления.КАЗ_СтатусыЗаявки.Черновик;
			Документ.Комментарий = "Импортировано из файла: " + ПутьКФайлу;
			Документ.Записать();

			СтрокаРезультата.Статус = "Загружено";
			СтрокаРезультата.Комментарий = "Заявка создана (черновик)";
			КоличествоЗагружено = КоличествоЗагружено + 1;

		КонецЕсли;

		Если СтрокаРезультата.Статус = "Ошибка" Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

	Возврат Новый Структура("КоличествоЗагружено, КоличествоОшибок", КоличествоЗагружено, КоличествоОшибок);

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Текст)

	Попытка
		Возврат Число(СтрЗаменить(Текст, ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции
