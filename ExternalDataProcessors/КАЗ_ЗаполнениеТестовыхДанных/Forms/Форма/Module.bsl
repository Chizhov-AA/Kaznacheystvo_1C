	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Документы

&НаСервере
Процедура УстановитьЛимиты(Дата, ЦФО1, Статья1, Лимит1, ЦФО2, Статья2, Лимит2, Лог)

	Метка = "ТЕСТ: установка лимитов (тестовые данные)";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лимиты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КАЗ_УстановкаЛимитов КАК Лимиты
	|ГДЕ
	|	Лимиты.Комментарий = &Метка";
	Запрос.УстановитьПараметр("Метка", Метка);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Возврат;
	КонецЕсли;

	Объект = Документы.КАЗ_УстановкаЛимитов.СоздатьДокумент();
	Объект.Дата = Дата;
	Объект.ПериодЛимита = Дата;
	Объект.Комментарий = Метка;

	Строка1 = Объект.Лимиты.Добавить();
	Строка1.ЦФО = ЦФО1;
	Строка1.СтатьяПлатежа = Статья1;
	Строка1.Лимит = Лимит1;

	Строка2 = Объект.Лимиты.Добавить();
	Строка2.ЦФО = ЦФО2;
	Строка2.СтатьяПлатежа = Статья2;
	Строка2.Лимит = Лимит2;

	Объект.Записать();

	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Лог.Добавить("Проведен документ установки лимитов: " + Строка(Объект.Номер));
	Исключение
		Лог.Добавить("Не удалось провести установку лимитов: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СоздатьЗаявку(Комментарий, Контрагент, Договор, СтатьяПлатежа, ЦФО, Сумма, Инициатор, Номенклатура, Лог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КАЗ_ЗаявкаНаОплату КАК Заявки
	|ГДЕ
	|	Заявки.Комментарий = &Комментарий";
	Запрос.УстановитьПараметр("Комментарий", Комментарий);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Лог.Добавить("Заявка уже существует, пропущена: " + Комментарий);
		Возврат;
	КонецЕсли;

	Объект = Документы.КАЗ_ЗаявкаНаОплату.СоздатьДокумент();
	Объект.Дата = ТекущаяДата();
	Объект.Контрагент = Контрагент;
	Объект.Договор = Договор;
	Объект.СтатьяПлатежа = СтатьяПлатежа;
	Объект.ЦФО = ЦФО;
	Объект.СуммаДокумента = Сумма;
	Объект.Приоритет = Перечисления.КАЗ_ПриоритетыПлатежа.Обычный;
	Объект.Статус = Перечисления.КАЗ_СтатусыЗаявки.Черновик;
	Объект.Инициатор = Инициатор;
	Объект.ЖелаемаяДатаОплаты = ТекущаяДата();
	Объект.Комментарий = Комментарий;

	Если Номенклатура <> Неопределено Тогда
		Строка = Объект.ТоварыУслуги.Добавить();
		Строка.Номенклатура = Номенклатура;
		Строка.Количество = 2;
		Строка.Цена = Сумма / 2;
		Строка.Сумма = Сумма;
	КонецЕсли;

	// Сохраняем как черновик независимо от результата проведения - сверхлимитная
	// заявка намеренно остается видна в статусе "не проведена" для демонстрации отказа.
	Объект.Записать();

	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Лог.Добавить("Проведена заявка: " + Комментарий);
	Исключение
		Лог.Добавить("Заявка не проведена (ожидаемо для сверхлимитной): " + Комментарий + " - " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
