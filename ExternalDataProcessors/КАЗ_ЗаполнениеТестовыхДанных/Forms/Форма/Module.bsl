&НаКлиенте
Процедура ЗаполнитьТестовыеДанные(Команда)

	Результат = ЗаполнитьТестовыеДанныеНаСервере();
	Для Каждого Строка Из Результат Цикл
		Сообщить(Строка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьТестовыеДанныеНаСервере()

	Лог = Новый Массив;

	// --- 1. НСИ ---

	ЦФОИнформатика = НайтиИлиСоздатьЦФО("Кафедра информатики и вычислительной техники", Лог);
	ЦФОЭкономика = НайтиИлиСоздатьЦФО("Кафедра экономики и финансов", Лог);
	НайтиИлиСоздатьЦФО("Деканат экономического факультета", Лог);
	НайтиИлиСоздатьЦФО("Ректорат", Лог);
	НайтиИлиСоздатьЦФО("Административно-хозяйственная часть", Лог);

	СтатьяАренда = НайтиИлиСоздатьСтатьюПлатежа("Аренда помещений", Лог);
	СтатьяКоммуналка = НайтиИлиСоздатьСтатьюПлатежа("Коммунальные услуги", Лог);
	НайтиИлиСоздатьСтатьюПлатежа("Оплата труда (ФОТ)", Лог);
	СтатьяКанцтовары = НайтиИлиСоздатьСтатьюПлатежа("Канцелярские товары", Лог);
	СтатьяIT = НайтиИлиСоздатьСтатьюПлатежа("IT-оборудование и лицензии", Лог);
	НайтиИлиСоздатьСтатьюПлатежа("Командировочные расходы", Лог);

	НайтиИлиСоздатьБанковскийСчет("Расчетный счет в Сбербанке", "40701810000000000001", "044525225", Лог);
	НайтиИлиСоздатьБанковскийСчет("Расчетный счет в ВТБ", "40701810000000000002", "044525187", Лог);

	НайтиИлиСоздатьКассу("Касса главного корпуса", 50000, Лог);
	НайтиИлиСоздатьКассу("Касса общежития", 20000, Лог);

	НайтиИлиСоздатьПричинуОтклонения("Недостаточное обоснование расходов", Лог);
	НайтиИлиСоздатьПричинуОтклонения("Превышение установленного лимита", Лог);
	НайтиИлиСоздатьПричинуОтклонения("Ошибка в реквизитах документа", Лог);

	НайтиИлиСоздатьГрафикПериодичности("Ежемесячно", "Месяц", Лог);
	НайтиИлиСоздатьГрафикПериодичности("Ежеквартально", "Квартал", Лог);
	НайтиИлиСоздатьГрафикПериодичности("Разовый платеж", "Разово", Лог);

	НайтиИлиСоздатьБанкКонтрагента("ПАО Сбербанк", "044525225", Лог);
	НайтиИлиСоздатьБанкКонтрагента("Банк ВТБ (ПАО)", "044525187", Лог);
	НайтиИлиСоздатьБанкКонтрагента("АО Альфа-Банк", "044525593", Лог);

	НайтиИлиСоздатьКатегориюКонтрагента("Поставщики услуг", Лог);
	НайтиИлиСоздатьКатегориюКонтрагента("Подрядчики по ремонту", Лог);
	НайтиИлиСоздатьКатегориюКонтрагента("Прочие контрагенты", Лог);

	НайтиИлиСоздатьШаблонНазначения("Шаблон - аренда помещений", СтатьяАренда, "Оплата аренды помещений по договору", Лог);
	НайтиИлиСоздатьШаблонНазначения("Шаблон - коммунальные услуги", СтатьяКоммуналка, "Оплата коммунальных услуг", Лог);
	НайтиИлиСоздатьШаблонНазначения("Шаблон - канцелярские товары", СтатьяКанцтовары, "Оплата канцелярских товаров по счету", Лог);
	НайтиИлиСоздатьШаблонНазначения("Шаблон - IT-оборудование", СтатьяIT, "Оплата IT-оборудования и программного обеспечения по счету", Лог);

	Пользователь = ПервыйПользователь();

	МаршрутСтандартный = НайтиИлиСоздатьМаршрут("Стандартный маршрут", 0, 100000, Лог);
	МаршрутКрупный = НайтиИлиСоздатьМаршрут("Маршрут крупных сумм", 100000, 0, Лог);
	НайтиИлиСоздатьЭтапМаршрута(МаршрутСтандартный, "Этап 1 - Стандартный маршрут", 1, Пользователь, Лог);
	НайтиИлиСоздатьЭтапМаршрута(МаршрутКрупный, "Этап 1 - Маршрут крупных сумм", 1, Пользователь, Лог);

	НайтиИлиСоздатьОтветственногоСогласующего(ЦФОИнформатика, "Ответственный - Кафедра информатики", Пользователь, Лог);
	НайтиИлиСоздатьОтветственногоСогласующего(ЦФОЭкономика, "Ответственный - Кафедра экономики", Пользователь, Лог);

	// --- 2. Контрагенты и договоры (минимальный набор полей - интерактивная проверка
	//        заполнения на программную запись не распространяется) ---

	КонтрагентКанцТорг = НайтиИлиСоздатьКонтрагента("ООО ""КанцТорг""", Лог);
	КонтрагентСтройСервис = НайтиИлиСоздатьКонтрагента("ООО ""СтройСервис""", Лог);
	ДоговорКанцТорг = НайтиИлиСоздатьДоговор(КонтрагентКанцТорг, "Договор поставки №1 (КанцТорг)", Лог);
	ДоговорСтройСервис = НайтиИлиСоздатьДоговор(КонтрагентСтройСервис, "Договор подряда №1 (СтройСервис)", Лог);

	// --- 3. Установка лимитов ---

	НачалоМесяцаТек = НачалоМесяца(ТекущаяДата());
	УстановитьЛимиты(НачалоМесяцаТек, ЦФОЭкономика, СтатьяКанцтовары, 50000, ЦФОИнформатика, СтатьяIT, 200000, Лог);

	// --- 4. Заявки на оплату ---

	Номенклатура = ПерваяНоменклатура();

	СоздатьЗаявку("ТЕСТ: заявка в рамках лимита (канцтовары)", КонтрагентКанцТорг, ДоговорКанцТорг,
		СтатьяКанцтовары, ЦФОЭкономика, 30000, Пользователь, Номенклатура, Лог);

	СоздатьЗаявку("ТЕСТ: заявка в рамках лимита (IT-оборудование)", КонтрагентСтройСервис, ДоговорСтройСервис,
		СтатьяIT, ЦФОИнформатика, 150000, Пользователь, Неопределено, Лог);

	СоздатьЗаявку("ТЕСТ: заявка СВЕРХ лимита (демонстрация отказа в проведении)", КонтрагентКанцТорг, ДоговорКанцТорг,
		СтатьяКанцтовары, ЦФОЭкономика, 80000, Пользователь, Неопределено, Лог);

	Лог.Добавить("Готово. Бизнес-процесс согласования для тестовых заявок не запускался - это отдельный ручной шаг.");

	Возврат Лог;

КонецФункции

