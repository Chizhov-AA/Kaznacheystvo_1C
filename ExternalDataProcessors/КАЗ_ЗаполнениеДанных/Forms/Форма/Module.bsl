КонецПроцедуры

&НаСервере
Функция СоздатьЗаявку(Комментарий, Контрагент, Договор, СтатьяПлатежа, ЦФО, Сумма, Инициатор, Номенклатура, Лог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КАЗ_ЗаявкаНаОплату КАК Заявки
	|ГДЕ
	|	Заявки.Комментарий = &Комментарий";
	Запрос.УстановитьПараметр("Комментарий", Комментарий);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Лог.Добавить("Заявка уже существует, пропущена: " + Комментарий);
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Объект = Документы.КАЗ_ЗаявкаНаОплату.СоздатьДокумент();
	Объект.Дата = ТекущаяДата();
	Объект.Контрагент = Контрагент;
	Объект.Договор = Договор;
	Объект.СтатьяПлатежа = СтатьяПлатежа;
	Объект.ЦФО = ЦФО;
	Объект.СуммаДокумента = Сумма;
	Объект.Приоритет = Перечисления.КАЗ_ПриоритетыПлатежа.Обычный;
	Объект.Статус = Перечисления.КАЗ_СтатусыЗаявки.Черновик;
	Объект.Инициатор = Инициатор;
	Объект.ЖелаемаяДатаОплаты = ТекущаяДата();
	Объект.Комментарий = Комментарий;

	Если Номенклатура <> Неопределено Тогда
		Строка = Объект.ТоварыУслуги.Добавить();
		Строка.Номенклатура = Номенклатура;
		Строка.Количество = 2;
		Строка.Цена = Сумма / 2;
		Строка.Сумма = Сумма;
	КонецЕсли;

	// Сохраняем как черновик независимо от результата проведения - сверхлимитная
	// заявка намеренно остается видна в статусе "не проведена" для демонстрации отказа.
	Объект.Записать();

	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Лог.Добавить("Проведена заявка: " + Комментарий);
	Исключение
		Лог.Добавить("Заявка не проведена: " + Комментарий + " - " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Объект.Ссылка;

КонецФункции

