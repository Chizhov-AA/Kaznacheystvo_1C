&НаКлиенте
Процедура ЗаполнитьТестовыеДанные(Команда)

	Результат = ЗаполнитьТестовыеДанныеНаСервере();
	Для Каждого Строка Из Результат Цикл
		Сообщить(Строка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьДублиНаименований(Команда)

	Результат = ПометитьДублиНаименованийНаСервере();
	Если Результат.Количество() = 0 Тогда
		Сообщить("Дублей наименований (обрезанных из-за нехватки длины реквизита) не найдено.");
	Иначе
		Для Каждого Строка Из Результат Цикл
			Сообщить(Строка);
		КонецЦикла;
		Сообщить("Готово. Для окончательного удаления помеченных элементов выполните ""Все функции - Удаление помеченных объектов"".");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаполнитьТестовыеДанныеНаСервере()

	Лог = Новый Массив;

	// --- 1. НСИ ---

	ЦФОИнформатика = НайтиИлиСоздатьЦФО("Кафедра информатики и вычислительной техники", Лог);
	ЦФОЭкономика = НайтиИлиСоздатьЦФО("Кафедра экономики и финансов", Лог);
	ЦФОДеканатЭФ = НайтиИлиСоздатьЦФО("Деканат экономического факультета", Лог);
	ЦФОРекторат = НайтиИлиСоздатьЦФО("Ректорат", Лог);
	ЦФОАХЧ = НайтиИлиСоздатьЦФО("Административно-хозяйственная часть", Лог);

	СтатьяАренда = НайтиИлиСоздатьСтатьюПлатежа("Аренда помещений", Лог);
	СтатьяКоммуналка = НайтиИлиСоздатьСтатьюПлатежа("Коммунальные услуги", Лог);
	СтатьяФОТ = НайтиИлиСоздатьСтатьюПлатежа("Оплата труда (ФОТ)", Лог);
	СтатьяКанцтовары = НайтиИлиСоздатьСтатьюПлатежа("Канцелярские товары", Лог);
	СтатьяIT = НайтиИлиСоздатьСтатьюПлатежа("IT-оборудование и лицензии", Лог);
	СтатьяКомандировки = НайтиИлиСоздатьСтатьюПлатежа("Командировочные расходы", Лог);

	НайтиИлиСоздатьБанковскийСчет("Расчетный счет в Сбербанке", "40701810000000000001", "044525225", Лог);
	НайтиИлиСоздатьБанковскийСчет("Расчетный счет в ВТБ", "40701810000000000002", "044525187", Лог);

	КассаГлавногоКорпуса = НайтиИлиСоздатьКассу("Касса главного корпуса", 50000, Лог);
	НайтиИлиСоздатьКассу("Касса общежития", 20000, Лог);

	ПричинаНедостаточноОбоснования = НайтиИлиСоздатьПричинуОтклонения("Недостаточное обоснование расходов", Лог);
	ПричинаПревышениеЛимита = НайтиИлиСоздатьПричинуОтклонения("Превышение установленного лимита", Лог);
	НайтиИлиСоздатьПричинуОтклонения("Ошибка в реквизитах документа", Лог);

	НайтиИлиСоздатьГрафикПериодичности("Ежемесячно", "Месяц", Лог);
	НайтиИлиСоздатьГрафикПериодичности("Ежеквартально", "Квартал", Лог);
	НайтиИлиСоздатьГрафикПериодичности("Разовый платеж", "Разово", Лог);

	НайтиИлиСоздатьБанкКонтрагента("ПАО Сбербанк", "044525225", Лог);
	НайтиИлиСоздатьБанкКонтрагента("Банк ВТБ (ПАО)", "044525187", Лог);
	НайтиИлиСоздатьБанкКонтрагента("АО Альфа-Банк", "044525593", Лог);

	НайтиИлиСоздатьКатегориюКонтрагента("Поставщики услуг", Лог);
	НайтиИлиСоздатьКатегориюКонтрагента("Подрядчики по ремонту", Лог);
	НайтиИлиСоздатьКатегориюКонтрагента("Прочие контрагенты", Лог);

	НайтиИлиСоздатьШаблонНазначения("Шаблон - аренда помещений", СтатьяАренда, "Оплата аренды помещений по договору", Лог);
	НайтиИлиСоздатьШаблонНазначения("Шаблон - коммунальные услуги", СтатьяКоммуналка, "Оплата коммунальных услуг", Лог);
	НайтиИлиСоздатьШаблонНазначения("Шаблон - канцелярские товары", СтатьяКанцтовары, "Оплата канцелярских товаров по счету", Лог);
	НайтиИлиСоздатьШаблонНазначения("Шаблон - IT-оборудование", СтатьяIT, "Оплата IT-оборудования и программного обеспечения по счету", Лог);

	// --- 1.1. Пользователи (согласующие) ---

	ПользовательДекан = НайтиИлиСоздатьПользователя("Иванов И.И.", "Декан факультета информационных технологий", Лог);
	ПользовательБухгалтер = НайтиИлиСоздатьПользователя("Петрова А.С.", "Главный бухгалтер", Лог);
	ПользовательПроректор = НайтиИлиСоздатьПользователя("Сидоров П.Н.", "Проректор по экономике и финансам", Лог);

	// --- 1.2. Маршруты согласования и этапы ---

	МаршрутСтандартный = НайтиИлиСоздатьМаршрут("Стандартный маршрут", 0, 100000, Лог);
	МаршрутКрупный = НайтиИлиСоздатьМаршрут("Маршрут крупных сумм", 100000, 0, Лог);
	МаршрутКапитальный = НайтиИлиСоздатьМаршрут("Маршрут капитальных затрат", 500000, 0, Лог);
	МаршрутФОТ = НайтиИлиСоздатьМаршрут("Маршрут выплат по ФОТ", 0, 0, Лог);

	НайтиИлиСоздатьЭтапМаршрута(МаршрутСтандартный, "Этап 1 - Стандартный маршрут", 1, ПользовательБухгалтер, Лог);
	НайтиИлиСоздатьЭтапМаршрута(МаршрутКрупный, "Этап 1 - Маршрут крупных сумм", 1, ПользовательДекан, Лог);
	НайтиИлиСоздатьЭтапМаршрута(МаршрутКапитальный, "Этап 1 - Маршрут капитальных затрат", 1, ПользовательПроректор, Лог);
	НайтиИлиСоздатьЭтапМаршрута(МаршрутФОТ, "Этап 1 - Маршрут выплат по ФОТ", 1, ПользовательБухгалтер, Лог);

	// --- 1.3. Ответственные согласующие (реквизит Согласующий раньше оставался
	//          пустым, т.к. ПервыйПользователь() не находил ни одного элемента
	//          в справочнике Пользователи - теперь используются созданные выше) ---

	НайтиИлиСоздатьОтветственногоСогласующего(ЦФОИнформатика, "Ответственный - Кафедра информатики", ПользовательДекан, Лог);
	НайтиИлиСоздатьОтветственногоСогласующего(ЦФОЭкономика, "Ответственный - Кафедра экономики", ПользовательБухгалтер, Лог);
	НайтиИлиСоздатьОтветственногоСогласующего(ЦФОРекторат, "Ответственный - Ректорат", ПользовательПроректор, Лог);
	НайтиИлиСоздатьОтветственногоСогласующего(ЦФОАХЧ, "Ответственный - АХЧ", ПользовательБухгалтер, Лог);
	НайтиИлиСоздатьОтветственногоСогласующего(ЦФОДеканатЭФ, "Ответственный - Деканат ЭФ", ПользовательДекан, Лог);

	// --- 1.4. Настройки согласования ---

	НайтиИлиСоздатьНастройкуСогласования("Настройка - Кафедра информатики", ЦФОИнформатика, 0, 100000, 1, Лог);
	НайтиИлиСоздатьНастройкуСогласования("Настройка - Кафедра экономики", ЦФОЭкономика, 0, 100000, 1, Лог);
	НайтиИлиСоздатьНастройкуСогласования("Настройка - Ректорат", ЦФОРекторат, 100000, 0, 2, Лог);
	НайтиИлиСоздатьНастройкуСогласования("Настройка - Деканат ЭФ", ЦФОДеканатЭФ, 0, 50000, 1, Лог);
	НайтиИлиСоздатьНастройкуСогласования("Настройка - АХЧ", ЦФОАХЧ, 0, 200000, 1, Лог);

	// --- 1.5. Основания платежей и очереди платежей ---

	НайтиИлиСоздатьОснованиеПлатежа("Оплата по договору поставки", Истина, Лог);
	НайтиИлиСоздатьОснованиеПлатежа("Оплата по договору подряда", Истина, Лог);
	НайтиИлиСоздатьОснованиеПлатежа("Возмещение командировочных расходов", Ложь, Лог);
	НайтиИлиСоздатьОснованиеПлатежа("Оплата по счету без договора", Ложь, Лог);
	НайтиИлиСоздатьОснованиеПлатежа("Выплата по решению суда", Ложь, Лог);

	ОчередьПервая = НайтиИлиСоздатьОчередьПлатежа("Первая очередь", 1, "Обязательные платежи (налоги, ФОТ)", Лог);
	ОчередьВторая = НайтиИлиСоздатьОчередьПлатежа("Вторая очередь", 2, "Расчеты с поставщиками по договорам", Лог);
	НайтиИлиСоздатьОчередьПлатежа("Третья очередь", 3, "Хозяйственные расходы", Лог);
	НайтиИлиСоздатьОчередьПлатежа("Четвертая очередь", 4, "Прочие платежи", Лог);

	// --- 2. Контрагенты и договоры ---

	КонтрагентКанцТорг = НайтиИлиСоздатьКонтрагента("ООО ""КанцТорг""", Лог);
	КонтрагентСтройСервис = НайтиИлиСоздатьКонтрагента("ООО ""СтройСервис""", Лог);
	ДоговорКанцТорг = НайтиИлиСоздатьДоговор(КонтрагентКанцТорг, "Договор поставки №1 (КанцТорг)", Лог);
	ДоговорСтройСервис = НайтиИлиСоздатьДоговор(КонтрагентСтройСервис, "Договор подряда №1 (СтройСервис)", Лог);

	// --- 3. Установка лимитов (4 документа за разные периоды/ЦФО/статьи) ---

	НачалоМесяцаТек = НачалоМесяца(ТекущаяДата());
	НачалоМесяцаПред = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));

	СтрокиЛимитов1 = Новый Массив;
	СтрокиЛимитов1.Добавить(СтрокаЛимита(ЦФОЭкономика, СтатьяКанцтовары, 50000));
	СтрокиЛимитов1.Добавить(СтрокаЛимита(ЦФОИнформатика, СтатьяIT, 200000));
	УстановитьЛимиты("Лимиты на канцтовары и IT-оборудование (текущий месяц)", НачалоМесяцаТек, СтрокиЛимитов1, Лог);

	СтрокиЛимитов2 = Новый Массив;
	СтрокиЛимитов2.Добавить(СтрокаЛимита(ЦФОРекторат, СтатьяАренда, 300000));
	УстановитьЛимиты("Лимит на аренду для ректората (текущий месяц)", НачалоМесяцаТек, СтрокиЛимитов2, Лог);

	СтрокиЛимитов3 = Новый Массив;
	СтрокиЛимитов3.Добавить(СтрокаЛимита(ЦФОАХЧ, СтатьяКоммуналка, 150000));
	СтрокиЛимитов3.Добавить(СтрокаЛимита(ЦФОИнформатика, СтатьяКомандировки, 80000));
	УстановитьЛимиты("Лимиты на коммунальные услуги и командировки (текущий месяц)", НачалоМесяцаТек, СтрокиЛимитов3, Лог);

	СтрокиЛимитов4 = Новый Массив;
	СтрокиЛимитов4.Добавить(СтрокаЛимита(ЦФОЭкономика, СтатьяФОТ, 500000));
	УстановитьЛимиты("Лимит на ФОТ (предыдущий месяц)", НачалоМесяцаПред, СтрокиЛимитов4, Лог);

	// --- 4. Заявки на оплату ---

	Номенклатура = ПерваяНоменклатура();

	Заявка1 = СоздатьЗаявку("Закупка канцелярских товаров для деканата экономического факультета",
		КонтрагентКанцТорг, ДоговорКанцТорг, СтатьяКанцтовары, ЦФОЭкономика, 30000, ПользовательБухгалтер, Номенклатура, Лог);

	Заявка2 = СоздатьЗаявку("Поставка сетевого оборудования для кафедры информатики",
		КонтрагентСтройСервис, ДоговорСтройСервис, СтатьяIT, ЦФОИнформатика, 150000, ПользовательДекан, Неопределено, Лог);

	Заявка3 = СоздатьЗаявку("Закупка канцтоваров сверх утвержденного лимита (демонстрация отказа в проведении)",
		КонтрагентКанцТорг, ДоговорКанцТорг, СтатьяКанцтовары, ЦФОЭкономика, 80000, ПользовательБухгалтер, Неопределено, Лог);

	Заявка4 = СоздатьЗаявку("Оплата аренды главного учебного корпуса",
		КонтрагентСтройСервис, Неопределено, СтатьяАренда, ЦФОРекторат, 280000, ПользовательПроректор, Неопределено, Лог);

	Заявка5 = СоздатьЗаявку("Оплата коммунальных услуг за отопительный сезон",
		КонтрагентСтройСервис, Неопределено, СтатьяКоммуналка, ЦФОАХЧ, 140000, ПользовательБухгалтер, Неопределено, Лог);

	Заявка6 = СоздатьЗаявку("Возмещение командировочных расходов сотрудникам кафедры информатики",
		КонтрагентКанцТорг, Неопределено, СтатьяКомандировки, ЦФОИнформатика, 70000, ПользовательДекан, Неопределено, Лог);

	Заявка7 = СоздатьЗаявку("Выплата заработной платы преподавательскому составу",
		КонтрагентКанцТорг, Неопределено, СтатьяФОТ, ЦФОЭкономика, 450000, ПользовательБухгалтер, Неопределено, Лог);

	Заявка8 = СоздатьЗаявку("Закупка дополнительной партии канцелярских товаров",
		КонтрагентКанцТорг, ДоговорКанцТорг, СтатьяКанцтовары, ЦФОЭкономика, 15000, ПользовательБухгалтер, Неопределено, Лог);

	Заявка9 = СоздатьЗаявку("Поставка компьютерного оборудования для учебной лаборатории",
		КонтрагентСтройСервис, ДоговорСтройСервис, СтатьяIT, ЦФОИнформатика, 90000, ПользовательДекан, Неопределено, Лог);

	// Заявки специально для последующего аннулирования (п. 4.5)
	ЗаявкаНаАннулирование1 = СоздатьЗаявку("Закупка офисной мебели для деканата (решение отменено руководством)",
		КонтрагентКанцТорг, Неопределено, СтатьяФОТ, ЦФОЭкономика, 10000, ПользовательБухгалтер, Неопределено, Лог);

	ЗаявкаНаАннулирование2 = СоздатьЗаявку("Организация корпоративного мероприятия (заявка отозвана)",
		КонтрагентСтройСервис, Неопределено, СтатьяФОТ, ЦФОЭкономика, 8000, ПользовательБухгалтер, Неопределено, Лог);

	// --- 5. Согласование заявок (документ КАЗ_СогласованиеЗаявки) ---

	СоздатьСогласование("Согласование заявки на аренду главного корпуса", Заявка4, ПользовательПроректор,
		Перечисления.КАЗ_РешенияСогласования.Согласовано, 1, "Согласовано без замечаний", Лог);

	СоздатьСогласование("Согласование заявки на коммунальные услуги", Заявка5, ПользовательБухгалтер,
		Перечисления.КАЗ_РешенияСогласования.Согласовано, 1, "Согласовано, лимит не превышен", Лог);

	СоздатьСогласование("Согласование заявки на командировочные расходы", Заявка6, ПользовательДекан,
		Перечисления.КАЗ_РешенияСогласования.Отклонено, 1, "Требуется дополнительное обоснование", Лог);

	// --- 6. Аннулирование заявок ---

	СоздатьАннулирование("Аннулирование заявки на закупку офисной мебели", ЗаявкаНаАннулирование1,
		ПричинаНедостаточноОбоснования, "Отменено по решению руководства", Лог);

	СоздатьАннулирование("Аннулирование заявки на корпоративное мероприятие", ЗаявкаНаАннулирование2,
		ПричинаПревышениеЛимита, "Заявка отозвана инициатором", Лог);

	// --- 7. План оплат ---

	СоздатьПланОплат("План оплат на текущий месяц (канцтовары/IT)", НачалоМесяцаТек, Заявка1, КонтрагентКанцТорг,
		ОчередьВторая, 30000, Лог);
	СоздатьПланОплат("План оплат на текущий месяц (аренда)", НачалоМесяцаТек, Заявка4, КонтрагентСтройСервис,
		ОчередьПервая, 280000, Лог);
	СоздатьПланОплат("План оплат на текущий месяц (коммунальные)", НачалоМесяцаТек, Заявка5, КонтрагентСтройСервис,
		ОчередьПервая, 140000, Лог);
	СоздатьПланОплат("План оплат на текущий месяц (ФОТ)", НачалоМесяцаТек, Заявка7, КонтрагентКанцТорг,
		ОчередьПервая, 450000, Лог);

	// --- 8. Реестр платежей (объединяет несколько заявок, при проведении помечает их Оплачена) ---

	ЗаявкиРеестра1 = Новый Массив;
	ЗаявкиРеестра1.Добавить(Заявка1);
	ЗаявкиРеестра1.Добавить(Заявка2);
	СоздатьРеестрПлатежей("Реестр платежей по заявкам канцтоваров и IT-оборудования", ЗаявкиРеестра1, Лог);

	ЗаявкиРеестра2 = Новый Массив;
	ЗаявкиРеестра2.Добавить(Заявка4);
	СоздатьРеестрПлатежей("Реестр платежей по аренде", ЗаявкиРеестра2, Лог);

	ЗаявкиРеестра3 = Новый Массив;
	ЗаявкиРеестра3.Добавить(Заявка7);
	СоздатьРеестрПлатежей("Реестр платежей по ФОТ", ЗаявкиРеестра3, Лог);

	// --- 9. Приходные кассовые ордера (сначала пополняем кассу, чтобы расходные
	//        ордера ниже могли списать средства - проверка остатка в кассе иначе
	//        всегда будет давать отказ) ---

	СоздатьПриходныйОрдер("Возврат неиспользованного аванса от подрядчика", КассаГлавногоКорпуса,
		КонтрагентСтройСервис, 200000, "Возврат аванса по договору подряда", Лог);

	СоздатьПриходныйОрдер("Поступление наличных от арендатора помещения", КассаГлавногоКорпуса,
		КонтрагентКанцТорг, 100000, "Оплата за аренду площадей арендатором", Лог);

	СоздатьПриходныйОрдер("Возврат подотчетных сумм сотрудником", КассаГлавногоКорпуса,
		КонтрагентКанцТорг, 15000, "Возврат неизрасходованного аванса", Лог);

	// --- 10. Расходные кассовые ордера ---

	СоздатьРасходныйОрдер("Выдача наличных по заявке на командировочные расходы", КассаГлавногоКорпуса,
		Заявка6, 70000, "Соколов С.И.", "Возмещение командировочных расходов", Лог);

	СоздатьРасходныйОрдер("Выдача наличных на хозяйственные нужды", КассаГлавногоКорпуса,
		Неопределено, 12000, "Кузнецова О.В.", "Хозяйственные расходы (мелкий ремонт)", Лог);

	СоздатьРасходныйОрдер("Выдача наличных на представительские расходы", КассаГлавногоКорпуса,
		Неопределено, 8000, "Морозов Д.А.", "Представительские расходы", Лог);

	// --- 11. Бизнес-процесс согласования (запускаем для 1-2 заявок, чтобы
	//         появились записи в задачах) ---

	ЗапуститьБизнесПроцесс(Заявка8, Лог);
	ЗапуститьБизнесПроцесс(Заявка9, Лог);

	Возврат Лог;

