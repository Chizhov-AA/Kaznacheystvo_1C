#КонецОбласти

#Область УстранениеДублейНаименований

// Разовая очистка дублей, возникших из-за прежней недостаточной длины
// реквизита "Наименование" (25 символов) у справочников, в которые
// КАЗ_ЗаполнениеДанных записывает длинные описательные названия -
// имя обрезалось при записи, из-за чего поиск НайтиПоНаименованию(ПолноеИмя)
// переставал находить уже созданный элемент и при повторном запуске
// обработки создавался дубль. Длина реквизита исправлена в метаданных,
// но элементы, успевшие создаться дублями раньше, нужно устранить отдельно.

&НаСервере
Функция ПометитьДублиНаименованийНаСервере()

	Лог = Новый Массив;

	СписокСправочников = Новый Массив;
	СписокСправочников.Добавить("КАЗ_МаршрутыСогласования");
	СписокСправочников.Добавить("КАЗ_ЭтапыМаршрутаСогласования");
	СписокСправочников.Добавить("КАЗ_ШаблоныНазначенияПлатежа");
	СписокСправочников.Добавить("КАЗ_ОтветственныеСогласующие");
	СписокСправочников.Добавить("КАЗ_ОснованияПлатежей");
	СписокСправочников.Добавить("КАЗ_НастройкиСогласования");
	СписокСправочников.Добавить("КАЗ_ОчередиПлатежей");
	СписокСправочников.Добавить("КАЗ_КассыОрганизации");
	СписокСправочников.Добавить("КАЗ_КатегорииКонтрагентовКазначейства");
	СписокСправочников.Добавить("КАЗ_БанковскиеСчетаОрганизации");
	СписокСправочников.Добавить("КАЗ_БанкиКонтрагентов");
	СписокСправочников.Добавить("КАЗ_ПричиныОтклоненияЗаявок");
	СписокСправочников.Добавить("КАЗ_ГрафикиПериодичностиПлатежей");

	Для Каждого ИмяСправочника Из СписокСправочников Цикл
		ПометитьДублиСправочника(ИмяСправочника, Лог);
	КонецЦикла;

	Возврат Лог;

КонецФункции

&НаСервере
Процедура ПометитьДублиСправочника(ИмяСправочника, Лог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Каталог.Наименование КАК Наименование,
	|	Каталог.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Каталог
	|ГДЕ
	|	Каталог.Наименование В
	|		(ВЫБРАТЬ
	|			ВложенныйКаталог.Наименование
	|		ИЗ
	|			Справочник." + ИмяСправочника + " КАК ВложенныйКаталог
	|		СГРУППИРОВАТЬ ПО
	|			ВложенныйКаталог.Наименование
	|		ИМЕЮЩИЕ
	|			КОЛИЧЕСТВО(*) > 1)
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();

	ПредыдущееНаименование = Неопределено;
	КоличествоПомечено = 0;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Наименование <> ПредыдущееНаименование Тогда
			// первый элемент группы (по ссылке) - оставляем, остальные считаем дублями
			ПредыдущееНаименование = Выборка.Наименование;
		Иначе
			Попытка
				ОбъектДубля = Выборка.Ссылка.ПолучитьОбъект();
				ОбъектДубля.УстановитьПометкуУдаления(Истина);
				КоличествоПомечено = КоличествоПомечено + 1;
			Исключение
				Лог.Добавить("Не удалось пометить на удаление """ + Выборка.Наименование
					+ """ (" + ИмяСправочника + "): " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоПомечено > 0 Тогда
