#КонецОбласти

#Область Документы

// СтрокиЛимитов - Массив из Структура("ЦФО, СтатьяПлатежа, Лимит")
&НаСервере
Процедура УстановитьЛимиты(Метка, Дата, СтрокиЛимитов, Лог)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лимиты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КАЗ_УстановкаЛимитов КАК Лимиты
	|ГДЕ
	|	Лимиты.Комментарий = &Метка";
	Запрос.УстановитьПараметр("Метка", Метка);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Лог.Добавить("Установка лимитов уже существует, пропущена: " + Метка);
		Возврат;
	КонецЕсли;

	Объект = Документы.КАЗ_УстановкаЛимитов.СоздатьДокумент();
	Объект.Дата = Дата;
	Объект.ПериодЛимита = Дата;
	Объект.Комментарий = Метка;

	Для Каждого СтрокаИсточника Из СтрокиЛимитов Цикл
		СтрокаЛимита = Объект.Лимиты.Добавить();
		СтрокаЛимита.ЦФО = СтрокаИсточника.ЦФО;
		СтрокаЛимита.СтатьяПлатежа = СтрокаИсточника.СтатьяПлатежа;
		СтрокаЛимита.Лимит = СтрокаИсточника.Лимит;
	КонецЦикла;

	Объект.Записать();

	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Лог.Добавить("Проведен документ установки лимитов: " + Метка);
	Исключение
		Лог.Добавить("Не удалось провести установку лимитов (" + Метка + "): " + ОписаниеОшибки());
